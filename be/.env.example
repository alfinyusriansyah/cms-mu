# Database (PostgreSQL) - pindah dari Next.js ke sini
DATABASE_URL=postgresql://user:password@localhost:5432/next_cms

# Secret untuk sign JWT access_token FastAPI (BEDA dengan NEXTAUTH_SECRET di Next.js)
# Generate dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-random
JWT_EXPIRE_MINUTES=1440

# Origin frontend yang diizinkan CORS, pisahkan dengan koma kalau lebih dari satu
CORS_ORIGINS=http://localhost:3000
